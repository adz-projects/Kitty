# Node / frontend
node_modules/
dist/
dist-ssr/
*.local
.vite/

# Rust / Tauri
src-tauri/target/
target/
src-tauri/gen/

# Editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Env / secrets (never commit; secrets live in Windows Credential Manager)
.env
.env.*
!.env.example

# Python plugin build artifacts (plugins/ — see docs/PLUGINS.md).
# The frozen .exe outputs themselves are NOT ignored: src-tauri/binaries/
# holds intentionally-empty committed placeholders so a fresh clone can
# `cargo check` (see src-tauri/binaries/README.md). Never commit the real
# ~50-95MB PyInstaller output over them — rebuild with `python plugins/build.py`.
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
plugins/*/build/
# Per-plugin PyInstaller build venv (plugins/build.py) — isolated so a
# freeze only sees that plugin's own declared dependencies, not whatever
# happens to be installed in the system/dev Python environment.
plugins/*/.build-venv/
# Local SQLite probe/scratch databases a plugin's own dev tooling can leave
# behind (e.g. adaptive-pathway's `_probe_pathway.db-*`).
_probe_*.db-*

# Local Claude Code / OpenCode session config — machine-specific, not part
# of the shipped project.
.claude/
.opencode/

# Retired plugins — superseded and no longer built/bundled (see
# plugins/build.py's PLUGINS dict and its module doc comment). Kept on disk,
# untracked, as the behavioral oracle their replacements were verified
# against; not part of the shipped app.
plugins/bigtiny/
plugins/visualizations/
plugins/brave-mcp-search/
plugins/replacement-mcp/
