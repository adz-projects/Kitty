{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kitty",
  "version": "0.1.0",
  "identifier": "com.kitty.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data: https://asset.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "externalBin": [
      "binaries/adaptive-pathway-sidecar",
      "binaries/adaptive-pathway-mcp",
      "binaries/replacement-mcp",
      "binaries/brave-mcp-search",
      "binaries/wasm-math-mcp",
      "binaries/bigtiny-daemon"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "nsis-hooks.nsh"
      }
    }
  }
}
