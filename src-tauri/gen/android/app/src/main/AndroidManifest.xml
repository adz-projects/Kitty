<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Model downloads and in-progress agent turns run for a long time and
         must survive the app being backgrounded (docs/ANDROID.md Phase 7). A
         multi-GB GGUF over cellular — or an agent turn the user leaves running
         while switching apps — outlasts the few minutes a plain background app
         is allowed, so each is bracketed by a `dataSync` foreground service
         (`DownloadService` / `TurnService`): FOREGROUND_SERVICE to run one at
         all, FOREGROUND_SERVICE_DATA_SYNC because Android 14+ requires the type
         to be declared, POST_NOTIFICATIONS so their notifications (and the
         turn-complete toast) are actually visible on Android 13+, and WAKE_LOCK
         because Deep Doze otherwise suspends the CPU between maintenance
         windows and stalls the work. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- AndroidTV support -->
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <application
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.kitty"
        android:usesCleartextTraffic="${usesCleartextTraffic}">
        <!-- `windowSoftInputMode="adjustResize"`: without it Android pans the
             whole window up when the keyboard opens, sliding the header and
             model picker off the top of the screen. Resizing shrinks the
             WebView instead, so the composer rises to meet the keyboard and
             everything above it stays put with less room. -->
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:launchMode="singleTask"
            android:label="@string/main_activity_title"
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- AndroidTV support -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Holds the process alive (and out of Doze) for the duration of a
             model download. It moves no bytes itself — the transfer is Rust's,
             in `commands/models.rs`. Not exported: only this app starts it. -->
        <service
            android:name=".DownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Holds the process alive (and out of Doze) for the duration of an
             agent turn, so a turn the user leaves running keeps going when they
             switch apps. Does no work itself — the turn runs on the in-process
             daemon future (`lifecycle/bigtiny_embedded.rs`); bracketed from
             Rust in `bigtiny/stream.rs`. Not exported: only this app starts it. -->
        <service
            android:name=".TurnService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <provider
          android:name="androidx.core.content.FileProvider"
          android:authorities="${applicationId}.fileprovider"
          android:exported="false"
          android:grantUriPermissions="true">
          <meta-data
            android:name="android.support.FILE_PROVIDER_PATHS"
            android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
